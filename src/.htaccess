<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Si el archivo o directorio existe físicamente, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Si es un archivo estático (js, css, imágenes, etc.) que no existe, responder 404 en vez de devolver index.html
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|ico|svg|woff2?|eot|ttf|otf|json|map|webp)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Rutas SEO SSR para Perfiles Públicos de Entrenadores
  RewriteRule ^entrenador/([a-zA-Z0-9_-]+)/?$ entrenador.php?slug=$1 [L,QSA]
  RewriteRule ^sitemap-entrenadores\.xml$ sitemap.php [L]

  # Reescribir todas las demás rutas SPA hacia index.html
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # 1. Desactivar caché para index.html físicamente
    <Files "index.html">
        FileETag None
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </Files>

    # 2. Desactivar caché para cualquier archivo HTML
    <FilesMatch "\.(html|htm)$">
        FileETag None
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # 3. Desactivar caché para rutas virtuales de Angular (URLs sin extensión de archivo como /crear-americano)
    SetEnvIf Request_URI "^[^.]+$" NOCACHE=true
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate" env=NOCACHE
    Header set Pragma "no-cache" env=NOCACHE
    Header set Expires 0 env=NOCACHE

    # 4. Permitir caché larga para otros archivos estáticos compilados con hash único
    <FilesMatch "\.(css|js|woff2?|eot|ttf|otf|svg|png|jpe?g|gif|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
